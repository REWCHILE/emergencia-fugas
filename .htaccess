# ==============================================================================
# EMERGENCIA FUGAS - PERFORMANCE & HIGH SPEED OPTIMIZATIONS (.htaccess)
# ==============================================================================

# 0. REESCRITURA DE URLS LIMPIAS Y COMPATIBILIDAD (Sin .php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir /index.php a la raíz / (301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(?:index(?:\.php)?)\s [NC]
    RewriteRule ^ / [R=301,L]

    # Redirigir peticiones directas .php a la versión limpia (301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Si la petición coincide con un directorio físico o archivo existente, servirlo
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Soporte general para URLs amigables mapeando a archivo .php
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [NC,L,QSA]
</IfModule>

# 1. COMPRESIÓN GZIP / DEFLATE (Ahorro de hasta 75% en transferencia de texto)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 2. CACHÉ DEL NAVEGADOR (LEVERAGE BROWSER CACHING)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Fuentes WOFF2: 1 año (Inmutables)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Imágenes WebP, JPG, PNG: 1 año
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # CSS y JavaScript: 1 mes
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Documentos HTML: 0 segundos (siempre frescos)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 3. CABECERAS HTTP DE RENDIMIENTO Y SEGURIDAD
<IfModule mod_headers.c>
    # Cache-Control agresivo para fuentes e imágenes
    <FilesMatch "\.(woff2|webp|ico|jpg|jpeg|png)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Cache-Control para CSS y JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Cabeceras de Seguridad y Buenas Prácticas
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. MIME TYPES MODERNOS
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType text/markdown .txt
</IfModule>
